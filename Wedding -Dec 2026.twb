    <worksheet name='Hotel Status'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='HotelStatus' path='/workbooks/Wedding-Dec2026' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='Master Task+ (Wedding_Analytics_Master)' name='federated.1glp51t0txi6yo1f91cql1yy9vdm' />
          </datasources>
          <datasource-dependencies datasource='federated.1glp51t0txi6yo1f91cql1yy9vdm'>
            <column caption='Days Pending to Check-in' datatype='integer' name='[Calculation_1046783343308806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, TODAY(), [Check-in Date])' />
            </column>
            <column caption='Check-in Display' datatype='string' name='[Calculation_1046783356755976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Check-in Date]) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSE&#13;&#10;    DATENAME(&apos;day&apos;, [Check-in Date])&#13;&#10;    + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [Check-in Date]), 3)&#13;&#10;END' />
            </column>
            <column caption='Check-out Display' datatype='string' name='[Calculation_1046783356993545]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Check-out Date]) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSE&#13;&#10;    DATENAME(&apos;day&apos;, [Check-out Date])&#13;&#10;    + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [Check-out Date]), 3)&#13;&#10;END' />
            </column>
            <column caption='Hotel Status' datatype='string' name='[Calculation_1046783564525578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF TODAY() &lt; [Check-in Date] THEN&#13;&#10;    &quot;UPCOMING&quot;&#13;&#10;&#13;&#10;ELSEIF TODAY() &gt;= [Check-in Date]&#13;&#10;AND TODAY() &lt; [Check-out Date] THEN&#13;&#10;    &quot;CHECKED IN&quot;&#13;&#10;&#13;&#10;ELSEIF TODAY() = [Check-out Date] THEN&#13;&#10;    &quot;CHECK-OUT TODAY&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;CHECKED OUT&quot;&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Check-in Date]' role='dimension' type='ordinal' />
            <column datatype='date' name='[Check-out Date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Room Number]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Task/Relative Name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1046783343308806]' derivation='Min' name='[min:Calculation_1046783343308806:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1046783356755976]' derivation='None' name='[none:Calculation_1046783356755976:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1046783356993545]' derivation='None' name='[none:Calculation_1046783356993545:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1046783564525578]' derivation='None' name='[none:Calculation_1046783564525578:nk]' pivot='key' type='nominal' />
