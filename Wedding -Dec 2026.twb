      <aliases enabled='yes' />
      <column datatype='integer' name='[Actual Cost]' role='measure' type='quantitative' />
      <column datatype='string' name='[Assigned Owner]' role='dimension' type='nominal' />
      <column caption='Cost Variance' datatype='integer' name='[Calculation_1046782954242048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([Estimated Cost])- SUM([Actual Cost])' />
      </column>
      <column caption='Days Remaining Countdown' datatype='integer' name='[Calculation_1046782989398017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, TODAY(), [Due Date])' />
      </column>
      <column caption='Pie Position' datatype='integer' name='[Calculation_1046783018029058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Variance Color Indicator' datatype='string' name='[Calculation_1046783218339845]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Actual Cost])&gt; SUM([Estimated Cost])&#13;&#10;THEN &quot;Red&quot; ELSE &quot;Green&quot; END' />
      </column>
      <column caption='Days Pending to Check-in' datatype='integer' name='[Calculation_1046783343308806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, TODAY(), [Check-in Date])' />
      </column>
      <column caption='Days Pending to Check-out' datatype='integer' name='[Calculation_1046783343476743]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, TODAY(), [Check-out Date])' />
      </column>
      <column caption='Check-in Display' datatype='string' name='[Calculation_1046783356755976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Check-in Date]) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSE&#13;&#10;    DATENAME(&apos;day&apos;, [Check-in Date])&#13;&#10;    + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [Check-in Date]), 3)&#13;&#10;END' />
      </column>
      <column caption='Check-out Display' datatype='string' name='[Calculation_1046783356993545]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Check-out Date]) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSE&#13;&#10;    DATENAME(&apos;day&apos;, [Check-out Date])&#13;&#10;    + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [Check-out Date]), 3)&#13;&#10;END' />
      </column>
      <column caption='Hotel Status' datatype='string' name='[Calculation_1046783564525578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF TODAY() &lt; [Check-in Date] THEN&#13;&#10;    &quot;UPCOMING&quot;&#13;&#10;&#13;&#10;ELSEIF TODAY() &gt;= [Check-in Date]&#13;&#10;AND TODAY() &lt; [Check-out Date] THEN&#13;&#10;    &quot;CHECKED IN&quot;&#13;&#10;&#13;&#10;ELSEIF TODAY() = [Check-out Date] THEN&#13;&#10;    &quot;CHECK-OUT TODAY&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;CHECKED OUT&quot;&#13;&#10;END' />
      </column>
      <column caption='Stay Duration' datatype='integer' name='[Calculation_1046783569612811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;&apos;day&apos;,&#13;&#10;[Check-in Date],&#13;&#10;[Check-out Date])' />
      </column>
      <column caption='Check-ins Today' datatype='integer' name='[Calculation_1046783573921804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Check-in Date] = TODAY()&#13;&#10;    THEN [Task ID (Hospitality)]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Days Pending Status' datatype='string' name='[Calculation_1046783662444560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1046783343308806] &lt; 0 THEN&#13;&#10;    &quot;OVERDUE&quot;&#13;&#10;ELSEIF [Calculation_1046783343308806] = 0 THEN&#13;&#10;    &quot;TODAY&quot;&#13;&#10;ELSE&#13;&#10;    &quot;UPCOMING&quot;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Category/Event]' role='dimension' type='nominal' />
      <column datatype='date' name='[Check-in Date]' role='dimension' type='ordinal' />
      <column caption='Check-outs Today' datatype='integer' name='[Check-ins Today (copy)_1046783597756429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Check-out Date] = TODAY()&#13;&#10;    THEN [Task ID (Hospitality)]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Current Guests' datatype='integer' name='[Check-ins Today (copy)_1046783599194126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Check-in Date] &lt;= TODAY()&#13;&#10;AND [Check-out Date] &gt; TODAY()&#13;&#10;    THEN [Task ID (Hospitality)]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Upcoming Check-ins' datatype='integer' name='[Current Guests (copy)_1046783599898639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Check-in Date] &gt; TODAY()&#13;&#10;    THEN [Task ID (Hospitality)]&#13;&#10;    END&#13;&#10;)' />
      </column>
